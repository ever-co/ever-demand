{
	"$schema": "node_modules/lerna/schemas/lerna-schema.json",
	"version": "0.5.0",
	"npmClient": "pnpm",
	"packages": ["packages/*"],
	"command": {
		"publish": {
			"conventionalCommits": true,
			"ignoreChanges": ["*.md", "test/**", "**/*.spec.ts"],
			"message": "chore(release): %s"
		},
		"version": {
			"push": false
		}
	}
}
