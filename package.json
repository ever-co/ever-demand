{
	"name": "ever-demand",
	"version": "0.5.0",
	"description": "Ever Demand - Open-Source Commerce Platform for On-Demand Economy and Digital Marketplaces",
	"license": "AGPL-3.0",
	"homepage": "https://ever.co",
	"repository": {
		"type": "git",
		"url": "https://github.com/ever-co/ever-demand.git"
	},
	"bugs": {
		"url": "https://github.com/ever-co/ever-demand/issues"
	},
	"private": true,
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"packageManager": "pnpm@12.23.0",
	"scripts": {
		"prepare": "husky",
		"bootstrap": "pnpm install --frozen-lockfile",
		"build": "pnpm run build:common && pnpm -r --filter \"!@ever-platform/common\" --workspace-concurrency=2 run build",
		"clean": "pnpm -r run clean",
		"test": "pnpm -r --filter \"!@ever-platform/e2e\" --workspace-concurrency=1 run test",
		"typecheck": "pnpm -r run typecheck",
		"format": "prettier --write \"packages/**/*.{ts,tsx,js,json,scss,html}\"",
		"start:api": "pnpm run build:server && pnpm --filter @ever-platform/core start",
		"run:server": "pnpm run start:api",
		"run:server:dev": "pnpm --filter @ever-platform/core start:dev",
		"run:admin": "pnpm --filter @ever-platform/admin-web-angular start",
		"run:merchant": "pnpm --filter @ever-platform/merchant-tablet-ionic start",
		"run:shopmobile": "pnpm --filter @ever-platform/shop-mobile-ionic start",
		"run:shopexpo": "pnpm --filter @ever-platform/shop-mobile-expo start",
		"run:shopweb": "pnpm --filter @ever-platform/shop-web-angular start",
		"run:shopgatsby": "pnpm --filter @ever-platform/shop-web-gatsby develop",
		"run:carrier": "pnpm --filter @ever-platform/carrier-mobile-ionic start",
		"build:common": "pnpm --filter @ever-platform/common build",
		"build:common:angular": "pnpm --filter @ever-platform/common-angular build",
		"build:server": "pnpm run build:common && pnpm --filter @ever-platform/core build",
		"build:admin": "pnpm --filter @ever-platform/admin-web-angular build",
		"build:merchant": "pnpm --filter @ever-platform/merchant-tablet-ionic build",
		"build:shopmobile": "pnpm --filter @ever-platform/shop-mobile-ionic build",
		"build:shopweb": "pnpm --filter @ever-platform/shop-web-angular build",
		"build:carrier": "pnpm --filter @ever-platform/carrier-mobile-ionic build",
		"build:shopexpo": "pnpm --filter @ever-platform/shop-mobile-expo build",
		"build:shopgatsby": "pnpm --filter @ever-platform/shop-web-gatsby build",
		"build:all": "pnpm run build:server && pnpm run build:admin && pnpm run build:merchant && pnpm run build:shopmobile && pnpm run build:shopweb && pnpm run build:carrier",
		"e2e": "pnpm --filter @ever-platform/e2e test",
		"count": "cloc packages/core/src packages/common/src packages/common-angular/src packages/admin-web-angular/src packages/shop-web-angular/src packages/shop-mobile-ionic/src packages/carrier-mobile-ionic/src packages/merchant-tablet-ionic/src packages/shop-mobile-expo/src packages/shop-mobile-flutter/lib --exclude-dir=node_modules"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@types/node": "^26.6.10",
		"cross-env": "^10.1.0",
		"husky": "^9.1.7",
		"lerna": "^10.1.3",
		"prettier": "^3.10.1",
		"rimraf": "^6.1.4",
		"typescript": "~6.0.3"
	},
	"engines": {
		"node": ">=26.13.1",
		"pnpm": ">=12.23.0"
	}
}
