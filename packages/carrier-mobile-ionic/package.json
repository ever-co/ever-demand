{
	"name": "@ever-platform/carrier-mobile-ionic",
	"version": "0.5.0",
	"description": "Ever Demand Carrier Mobile App",
	"license": "GPL-3.0",
	"homepage": "https://ever.co/",
	"repository": {
		"type": "git",
		"url": "https://github.com/ever-co/ever-demand.git"
	},
	"bugs": {
		"url": "https://github.com/ever-co/ever-demand/issues"
	},
	"private": false,
	"type": "module",
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"scripts": {
		"config": "node scripts/configure.ts",
		"config:dev": "node scripts/configure.ts --environment=dev",
		"config:prod": "node scripts/configure.ts --environment=prod",
		"ng": "ng",
		"start": "pnpm run config:dev && ng serve --port 4203",
		"start:prod": "pnpm run config:prod && ng serve --port 4203 --configuration production",
		"build": "pnpm run config:prod && ng build --configuration production",
		"build:dev": "pnpm run config:dev && ng build --configuration development",
		"typecheck": "pnpm run config:dev && tsc -p tsconfig.app.json --noEmit",
		"test": "pnpm run config:dev && ng test --watch=false",
		"cap:sync": "pnpm run build && cap sync",
		"cap:add:android": "cap add android",
		"cap:run:android": "pnpm run build && cap run android",
		"clean": "rimraf www .angular"
	},
	"dependencies": {
		"@angular/common": "^22.3.0",
		"@angular/compiler": "^22.3.0",
		"@angular/core": "^22.3.0",
		"@angular/forms": "^22.3.0",
		"@angular/platform-browser": "^22.3.0",
		"@angular/router": "^22.3.0",
		"@apollo/client": "^4.3.8",
		"@capacitor/core": "^8.6.3",
		"@capacitor/device": "^8.0.3",
		"@capacitor/geolocation": "^8.2.5",
		"@capacitor/local-notifications": "^8.3.1",
		"@capacitor/network": "^8.0.1",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.4",
		"@ever-platform/common": "workspace:*",
		"@ever-platform/common-angular": "workspace:*",
		"@ionic/angular": "^9.0.14",
		"@ngx-translate/core": "^18.1.0",
		"@ngx-translate/http-loader": "^18.1.0",
		"apollo-angular": "^14.2.0",
		"graphql": "^16.15.0",
		"graphql-ws": "^6.4.3",
		"ionicons": "^8.1.1",
		"lodash": "^4.18.1",
		"mixpanel-browser": "^2.86.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"socket.io-client": "^4.8.4",
		"swiper": "^14.4.0",
		"tslib": "^2.9.1",
		"underscore": "^1.13.8",
		"uuid": "^14.0.3",
		"zone.js": "^0.16.3"
	},
	"devDependencies": {
		"@angular/build": "^22.3.0",
		"@angular/cli": "^22.3.0",
		"@angular/compiler-cli": "^22.3.0",
		"@capacitor/android": "^8.6.3",
		"@capacitor/cli": "^8.6.3",
		"@capacitor/ios": "^8.6.3",
		"@types/google.maps": "^3.67.0",
		"@types/node": "^26.6.10",
		"envalid": "^9.0.0",
		"jsdom": "^31.0.1",
		"rimraf": "^6.1.4",
		"typescript": "~6.0.3",
		"vitest": "^5.1.2"
	},
	"engines": {
		"node": ">=26.13.1",
		"pnpm": ">=12.23.0"
	}
}
