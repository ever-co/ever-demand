{
	"name": "@ever-platform/shop-web-angular",
	"version": "0.5.0",
	"description": "Ever Demand Web Shop",
	"license": "AGPL-3.0",
	"homepage": "https://ever.co",
	"repository": {
		"type": "git",
		"url": "https://github.com/ever-co/ever-demand.git"
	},
	"bugs": {
		"url": "https://github.com/ever-co/ever-demand/issues"
	},
	"private": false,
	"type": "module",
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"scripts": {
		"ng": "ng",
		"config": "node scripts/configure.ts --environment=dev",
		"config:dev": "node scripts/configure.ts --environment=dev",
		"config:prod": "node scripts/configure.ts --environment=prod",
		"start": "pnpm run config:dev && ng serve",
		"start:prod": "pnpm run config:prod && ng serve --configuration production",
		"build": "pnpm run config:prod && ng build --configuration production",
		"build:prod": "pnpm run config:prod && ng build --configuration production",
		"build:dev": "pnpm run config:dev && ng build --configuration development",
		"watch": "pnpm run config:dev && ng build --configuration development --watch",
		"typecheck": "pnpm run config:dev && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
		"test": "pnpm run config:dev && ng test --no-watch",
		"test:watch": "pnpm run config:dev && ng test",
		"i18n:check": "node ./scripts/check-i18n.cjs",
		"a11y:check-icon-buttons": "node ./scripts/check-icon-buttons.cjs",
		"a11y:check-icon-buttons:test": "node ./scripts/check-icon-buttons.test.cjs",
		"clean": "rimraf build .angular dist"
	},
	"dependencies": {
		"@angular/animations": "^22.3.0",
		"@angular/cdk": "^22.3.0",
		"@angular/common": "^22.3.0",
		"@angular/compiler": "^22.3.0",
		"@angular/core": "^22.3.0",
		"@angular/forms": "^22.3.0",
		"@angular/google-maps": "^22.3.0",
		"@angular/material": "^22.3.0",
		"@angular/platform-browser": "^22.3.0",
		"@angular/router": "^22.3.0",
		"@apollo/client": "^4.3.8",
		"@ever-platform/common": "workspace:*",
		"@ever-platform/common-angular": "workspace:*",
		"@fortawesome/angular-fontawesome": "^5.1.0",
		"@fortawesome/fontawesome-svg-core": "^7.3.1",
		"@fortawesome/free-brands-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@ngx-translate/core": "^18.1.0",
		"@ngx-translate/http-loader": "^18.1.0",
		"apollo-angular": "^14.2.0",
		"bootstrap": "^5.3.9",
		"graphql": "^16.15.0",
		"graphql-ws": "^6.4.3",
		"lodash": "^4.18.1",
		"ngx-infinite-scroll": "^22.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"socket.io-client": "^4.8.4",
		"tslib": "^2.9.1",
		"underscore": "^1.13.8",
		"uuid": "^14.0.3",
		"zone.js": "^0.16.3"
	},
	"devDependencies": {
		"@angular/build": "^22.3.0",
		"@angular/cli": "^22.3.0",
		"@angular/compiler-cli": "^22.3.0",
		"@types/google.maps": "^3.67.0",
		"@types/node": "^26.6.10",
		"envalid": "^9.0.0",
		"jsdom": "^31.0.1",
		"rimraf": "^6.1.4",
		"typescript": "~6.0.3",
		"vitest": "^5.1.2"
	},
	"engines": {
		"node": ">=26.13.1"
	},
	"snyk": false
}
