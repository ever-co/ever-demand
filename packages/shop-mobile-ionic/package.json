{
	"name": "@ever-platform/shop-mobile-ionic",
	"version": "0.5.0",
	"description": "Ever Shop Mobile App",
	"license": "GPL-3.0",
	"homepage": "https://ever.co/",
	"repository": {
		"type": "git",
		"url": "https://github.com/ever-co/ever-demand.git"
	},
	"bugs": {
		"url": "https://github.com/ever-co/ever-demand/issues"
	},
	"private": true,
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"scripts": {
		"ng": "ng",
		"config": "node scripts/configure.ts",
		"config:dev": "node scripts/configure.ts --environment=dev",
		"config:prod": "node scripts/configure.ts --environment=prod",
		"start": "pnpm run config:dev && cross-env NODE_OPTIONS=--max-old-space-size=4096 ng serve --port 4201",
		"start:prod": "pnpm run config:prod && cross-env NODE_OPTIONS=--max-old-space-size=4096 ng serve --port 4201 --configuration production",
		"build": "pnpm run config:dev && cross-env NODE_OPTIONS=--max-old-space-size=4096 ng build --configuration development",
		"build:prod": "pnpm run config:prod && cross-env NODE_OPTIONS=--max-old-space-size=4096 ng build --configuration production",
		"typecheck": "pnpm run config:dev && tsc -p tsconfig.spec.json --noEmit",
		"test": "pnpm run config:dev && ng test --watch=false",
		"e2e": "pnpm --filter @ever-platform/e2e exec playwright test --project=shop-mobile",
		"cap:sync": "pnpm run build:prod && cap sync",
		"cap:android": "pnpm run build:prod && cap sync android && cap open android",
		"cap:ios": "pnpm run build:prod && cap sync ios && cap open ios",
		"clean": "rimraf www .angular"
	},
	"dependencies": {
		"@angular/cdk": "^22.3.0",
		"@angular/common": "^22.3.0",
		"@angular/compiler": "^22.3.0",
		"@angular/core": "^22.3.0",
		"@angular/forms": "^22.3.0",
		"@angular/platform-browser": "^22.3.0",
		"@angular/router": "^22.3.0",
		"@angular/service-worker": "^22.3.0",
		"@apollo/client": "^4.3.8",
		"@capacitor-mlkit/barcode-scanning": "^8.2.2",
		"@capacitor/android": "^8.6.3",
		"@capacitor/app": "^8.1.2",
		"@capacitor/browser": "^8.0.5",
		"@capacitor/camera": "^8.2.6",
		"@capacitor/core": "^8.6.3",
		"@capacitor/device": "^8.0.3",
		"@capacitor/dialog": "^8.0.1",
		"@capacitor/geolocation": "^8.2.5",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/ios": "^8.6.3",
		"@capacitor/local-notifications": "^8.3.1",
		"@capacitor/network": "^8.0.1",
		"@capacitor/preferences": "^8.0.1",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.4",
		"@ever-platform/common": "workspace:*",
		"@ever-platform/common-angular": "workspace:*",
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@ionic/angular": "^9.0.14",
		"@ionic/storage-angular": "^4.0.0",
		"@ngx-translate/core": "^18.1.0",
		"@ngx-translate/http-loader": "^18.1.0",
		"apollo-angular": "^14.2.0",
		"bootstrap": "^5.3.9",
		"graphql": "^16.15.0",
		"graphql-ws": "^6.4.3",
		"ionicons": "^8.1.1",
		"jsbarcode": "^3.12.3",
		"lodash": "^4.18.1",
		"ngx-progressbar": "^14.0.0",
		"qrcode": "^1.5.4",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"socket.io-client": "^4.8.4",
		"swiper": "^14.4.0",
		"tslib": "^2.9.1",
		"underscore": "^1.13.8",
		"uuid": "^14.0.3",
		"zone.js": "^0.16.3"
	},
	"devDependencies": {
		"@angular/build": "^22.3.0",
		"@angular/cli": "^22.3.0",
		"@angular/compiler-cli": "^22.3.0",
		"@angular/localize": "^22.3.0",
		"@capacitor/cli": "^8.6.3",
		"@types/google.maps": "^3.67.0",
		"@types/lodash": "^4.17.27",
		"@types/node": "^26.6.10",
		"@types/qrcode": "^1.5.6",
		"cross-env": "^10.1.0",
		"dotenv": "^18.0.10",
		"envalid": "^9.0.0",
		"jsdom": "^31.0.1",
		"rimraf": "^6.1.4",
		"stripe": "^23.2.0",
		"typescript": "~6.0.3",
		"vitest": "^5.1.2"
	},
	"engines": {
		"node": ">=26.13.1"
	},
	"snyk": false
}
