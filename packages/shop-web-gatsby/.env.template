# NOTE: do NOT ever put here any secure settings! (e.g. Secret Keys)
# Gatsby inlines only GATSBY_* variables into the browser bundle (see src/config.ts).
# Copy to .env.development (gatsby develop) or .env.production (gatsby build).

# GraphQL endpoint of the Ever API
GATSBY_GQL_ENDPOINT=http://localhost:8443/graphql

# Fixed visitor location; leave both empty to ask the browser (fallback: Sofia)
GATSBY_DEFAULT_LATITUDE=42.6459136
GATSBY_DEFAULT_LONGITUDE=23.3332736

# Google Maps JS API key (restrict it!); without one the sign-up page shows no map
GATSBY_GOOGLE_MAPS_API_KEY=
