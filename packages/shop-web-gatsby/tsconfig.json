{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"jsx": "react-jsx",
		"lib": ["es2024", "dom", "dom.iterable"],
		"types": ["node", "vitest/globals"],
		"allowImportingTsExtensions": false,
		"experimentalDecorators": false,
		"emitDecoratorMetadata": false
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"gatsby-*.ts",
		"gatsby-*.tsx",
		"codegen.ts",
		"vitest.config.ts"
	],
	"exclude": ["node_modules", "public", ".cache"]
}
