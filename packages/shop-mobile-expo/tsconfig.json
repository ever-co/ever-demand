{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["jest", "node"]
	},
	"include": ["index.ts", "app.config.ts", "src/**/*.ts", "src/**/*.tsx", "jest.setup.ts"],
	"exclude": ["node_modules", "dist", "dist-android"]
}
