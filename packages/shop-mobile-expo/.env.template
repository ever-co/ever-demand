# Ever Demand shop app (Expo). Copy to `.env` (git-ignored) and change what you need.
# Every EXPO_PUBLIC_* value is inlined into the app bundle: never put a secret here.
# Defaults (used when a line is missing) are the ones shown.

# Backend (see docs/latest-stack/CONTRACT.md, "Backend contract")
EXPO_PUBLIC_SERVICES_ENDPOINT=http://localhost:5500
EXPO_PUBLIC_GQL_ENDPOINT=http://localhost:8443/graphql
EXPO_PUBLIC_GQL_SUBSCRIPTIONS_ENDPOINT=ws://localhost:2086/subscriptions
# Android emulators reach the host through 10.0.2.2, for example:
# EXPO_PUBLIC_SERVICES_ENDPOINT=http://10.0.2.2:5500

# Tenant (business) of this shop, sent to the API as `Tenant-Id` and in every socket handshake
# (docs/multi-tenant/DESIGN.md §3.3). White-label build: its slug or 24-hex id. Empty: the web
# build uses the <slug> of a <slug>.<EXPO_PUBLIC_TENANT_BASE_DOMAIN> page host, then a
# `?tenant=<slug>` link (kept for later visits); with none, the API decides (single-tenant
# installs use their default tenant).
EXPO_PUBLIC_TENANT=
# Parent domain of tenant hosts on the web build, e.g. everdemand.co; empty = not used
EXPO_PUBLIC_TENANT_BASE_DOMAIN=

EXPO_PUBLIC_PRODUCTION=false
EXPO_PUBLIC_VERSION=0.6.0

# 'slides' | 'list'
EXPO_PUBLIC_PRODUCTS_VIEW_TYPE=slides
# 'page' | 'popup'
EXPO_PUBLIC_ORDER_INFO_TYPE=page

# Empty: the bundled Ever logo
EXPO_PUBLIC_INVITE_BY_CODE_LOGO=
EXPO_PUBLIC_NO_INTERNET_LOGO=
EXPO_PUBLIC_COMPANY_NAME=Ever Co. LTD

EXPO_PUBLIC_DEFAULT_LANGUAGE=en-US
EXPO_PUBLIC_DEFAULT_LOCALE=en-US
EXPO_PUBLIC_DELIVERY_TIME_MIN=30
EXPO_PUBLIC_DELIVERY_TIME_MAX=60
# Side menu "Call us"; empty hides the item
EXPO_PUBLIC_SUPPORT_NUMBER=0888888888

# Card payments; empty disables them
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# When both are set the app never asks the device for its location. Set both empty to use GPS.
EXPO_PUBLIC_DEFAULT_LATITUDE=42.6459136
EXPO_PUBLIC_DEFAULT_LONGITUDE=23.3332736

# Device uuid sent to `device.create`; empty generates one per install
EXPO_PUBLIC_FAKE_UUID=

# Dev invite code that registers without a server invite (8321). `off` disables it (production).
EXPO_PUBLIC_FAKE_INVITE_CODE=8321
EXPO_PUBLIC_FAKE_INVITE_ID=1ae9d04f9010d834f8906881
EXPO_PUBLIC_FAKE_INVITE_CITY=Sofia
EXPO_PUBLIC_FAKE_INVITE_POSTCODE=1700
EXPO_PUBLIC_FAKE_INVITE_ADDRESS=Simeonovsko shose
EXPO_PUBLIC_FAKE_INVITE_HOUSE=104
EXPO_PUBLIC_FAKE_INVITE_APARTMENT=3
EXPO_PUBLIC_FAKE_INVITE_COUNTRY_ID=21

# Maintenance micro service; empty URL = no maintenance check
EXPO_PUBLIC_SETTINGS_APP_TYPE=shop-mobile
EXPO_PUBLIC_SETTINGS_MAINTENANCE_API_URL=

# "Single merchant" (several branches): comma-separated warehouse ids
EXPO_PUBLIC_MERCHANT_IDS=
# Orders stay open and Buy adds to the same order
EXPO_PUBLIC_SHOPPING_CART=false

# Native builds only (read by app.config.ts, not by the bundle)
GOOGLE_MAPS_API_KEY=
STRIPE_MERCHANT_IDENTIFIER=
