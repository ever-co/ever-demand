{
	"name": "@ever-platform/shop-mobile-expo",
	"version": "0.6.0",
	"description": "Ever Demand customer shop app built with Expo (React Native, iOS / Android / web)",
	"license": "GPL-3.0",
	"homepage": "https://ever.co/",
	"repository": {
		"type": "git",
		"url": "https://github.com/ever-co/ever-demand.git"
	},
	"bugs": {
		"url": "https://github.com/ever-co/ever-demand/issues"
	},
	"private": true,
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"main": "index.ts",
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web --port 8081",
		"build": "expo export --platform web --output-dir dist",
		"export:web": "expo export --platform web --output-dir dist",
		"export:android": "expo export --platform android --output-dir dist-android",
		"serve:web": "node scripts/serve-web.mjs",
		"typecheck": "tsc --noEmit",
		"test": "jest --maxWorkers=1",
		"doctor": "expo-doctor"
	},
	"dependencies": {
		"@apollo/client": "^4.3.8",
		"@expo/metro-runtime": "~58.0.17",
		"@expo/vector-icons": "^15.0.2",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/netinfo": "12.0.1",
		"@react-navigation/drawer": "^7.14.5",
		"@react-navigation/native": "^7.5.2",
		"@reduxjs/toolkit": "^2.15.0",
		"@stripe/react-stripe-js": "^7.1.0",
		"@stripe/stripe-js": "^10.4.0",
		"@stripe/stripe-react-native": "0.81.0",
		"expo": "~58.0.26",
		"expo-camera": "~58.0.14",
		"expo-constants": "~58.0.16",
		"expo-crypto": "~58.0.8",
		"expo-font": "~58.0.12",
		"expo-linking": "~58.0.17",
		"expo-localization": "~58.0.5",
		"expo-location": "~58.0.22",
		"expo-splash-screen": "~58.0.14",
		"expo-status-bar": "~58.0.5",
		"expo-system-ui": "~58.0.7",
		"graphql": "^16.15.0",
		"graphql-ws": "^6.4.3",
		"i18next": "^27.2.9",
		"jsbarcode": "^3.12.3",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-i18next": "^18.0.3",
		"react-native": "0.88.1",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-maps": "1.29.11",
		"react-native-paper": "^5.15.5",
		"react-native-qrcode-svg": "^6.3.55",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-svg": "15.16.0",
		"react-native-web": "~0.21.4",
		"react-native-webview": "14.0.1",
		"react-native-worklets": "0.13.0",
		"react-redux": "^9.3.1",
		"rxjs": "^7.8.2",
		"socket.io-client": "^4.8.4"
	},
	"devDependencies": {
		"@babel/core": "^7.29.13",
		"@react-native/jest-preset": "^0.88.1",
		"@testing-library/react-native": "^14.1.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.10",
		"@types/react": "^19.3.3",
		"jest": "^30.5.2",
		"jest-expo": "~58.0.15",
		"test-renderer": "^1.3.1",
		"typescript": "~6.0.3"
	},
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"listUnknownPackages": false
			}
		}
	},
	"engines": {
		"node": ">=26.13.1"
	}
