{
	"name": "@ever-platform/admin-web-angular",
	"version": "0.5.0",
	"description": "Ever Admin",
	"license": "AGPL-3.0",
	"homepage": "https://ever.co",
	"repository": {
		"type": "git",
		"url": "https://github.com/ever-co/ever-demand.git"
	},
	"bugs": {
		"url": "https://github.com/ever-co/ever-demand/issues"
	},
	"private": false,
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"scripts": {
		"config": "node scripts/configure.ts",
		"config:dev": "node scripts/configure.ts --environment=dev",
		"config:prod": "node scripts/configure.ts --environment=prod",
		"ng": "ng",
		"start": "pnpm run config:dev && ng serve",
		"build": "pnpm run config:prod && ng build",
		"build:dev": "pnpm run config:dev && ng build --configuration development",
		"typecheck": "pnpm run config:dev && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
		"test": "pnpm run config:dev && ng test",
		"e2e": "pnpm --filter @ever-platform/e2e exec playwright test --project=admin",
		"clean": "rimraf build .angular"
	},
	"dependencies": {
