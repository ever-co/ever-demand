{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": "..",
		"types": ["node"],
		"paths": {
			"@pyro/*": ["../common/src/@pyro/*"],
			"@modules/server.common/*": ["../common/src/*"],
			"@modules/client.common.angular2/*": ["./src/*"],
			"mongoose": ["./src/mongoose-placeholder"],
			"typeorm": ["./src/typeorm-placeholder"]
		}
	},
	"include": ["./src/**/*.ts"],
	"exclude": ["./src/**/*.spec.ts"]
}
