{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "./build",
		"rootDir": "./src",
		"types": ["node"],
		"paths": {
			"@pyro/*": ["./src/@pyro/*"]
		}
	},
	"include": ["./src/**/*.ts"],
	"exclude": ["./src/**/*.spec.ts"]
}
