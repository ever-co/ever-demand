{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"rootDir": "..",
		"outDir": "./build",
		"noEmit": true,
		"types": ["node", "jest"],
		"paths": {
			"@pyro/db-server": ["./src/@pyro/db-server"],
			"@pyro/db-server/*": ["./src/@pyro/db-server/*"],
			"@pyro/io": ["./src/@pyro/io"],
			"@pyro/io/*": ["./src/@pyro/io/*"],
			"@pyro/*": ["../common/src/@pyro/*"],
			"@modules/server.common/*": ["../common/src/*"]
		}
	},
	"include": ["./src/**/*.ts", "./test/**/*.ts"]
}
