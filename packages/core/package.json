	"scripts": {
		"build": "rimraf build .common-types && tsc -p ../common/tsconfig.build.json --declaration --emitDeclarationOnly --sourceMap false --outDir .common-types && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"start": "cross-env NODE_ENV=development node build/main.js",
		"start:dev": "pnpm run build && cross-env NODE_ENV=development concurrently -k -n tsc,api \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"node --watch-path=build build/main.js\"",
		"start:prod": "cross-env NODE_ENV=production node build/main.js",
		"test": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning --max-old-space-size=3072\" jest --maxWorkers=1",
		"test:e2e": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning --max-old-space-size=3072\" jest --config jest.e2e.config.js --runInBand",
		"db:test:up": "node scripts/test-mongo.mjs up",
		"db:test:down": "node scripts/test-mongo.mjs down",
		"clean": "rimraf build coverage .common-types",
		"format": "prettier \"src/**/*.ts\" --write"
	},
	"publishConfig": {
		"access": "public"
	},
