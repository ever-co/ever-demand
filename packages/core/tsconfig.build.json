{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"rootDir": "./src",
		"outDir": "./build",
		"types": ["node"],
		"paths": {
			"@pyro/db-server": ["./src/@pyro/db-server"],
			"@pyro/db-server/*": ["./src/@pyro/db-server/*"],
			"@pyro/io": ["./src/@pyro/io"],
			"@pyro/io/*": ["./src/@pyro/io/*"],
			"@pyro/*": ["./.common-types/@pyro/*"],
			"@modules/server.common/*": ["./.common-types/*"]
		}
	},
	"include": ["./src/**/*.ts"],
	"exclude": ["./src/**/*.spec.ts", "./src/test/**"]
}
